<Window x:Class="VisionSort_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionSort 智能质检系统" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <!-- 定义两列：左侧占 70%，右侧占 30% -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧：视频/图像显示区 ========== -->
        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="2" Margin="5" Background="#222">
            <Grid>
                <!-- 摄像头画面 -->
                <Image Source="{Binding CurrentFrame}" Stretch="Uniform" />

                <!-- 检测结果浮层（保留，显示在画面左上角） -->
                <Border Background="#AA000000" Padding="10" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <TextBlock Text="状态：等待检测" Foreground="Yellow" FontWeight="Bold" FontSize="16"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========== 右侧：控制面板 ========== -->
        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
            <TextBlock Text="⚙ 控制台" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- 连接配置 -->
            <TextBlock Text="服务器 IP" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtIP" Text="127.0.0.1" Margin="0,5,0,10"/>

            <TextBlock Text="端口" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtPort" Text="8888" Margin="0,5,0,10"/>
            <!-- 产品型号选择 -->
            <TextBlock Text="产品型号" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <ComboBox x:Name="CmbProduct" 
                    SelectedValue="{Binding SelectedProductCode}"
                    SelectedValuePath="Content">
                <ComboBoxItem Content="产品A" />
                <ComboBoxItem Content="产品B" />
                <ComboBoxItem Content="产品C" />
            </ComboBox>

            <!-- 按钮区域 -->
            <Button x:Name="BtnConnect" Content="🔗 连接服务器" Height="35" Margin="0,5,0,10" 
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>

            <Button x:Name="BtnDetect" Content="🔍 执行检测" Height="35" Margin="0,5,0,10"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <Button x:Name="BtnHistory" Content="📋 查看历史" Height="35" Width="100" Margin="0,0,5,0"
            Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="BtnSettings" Content="⚙ 设置" Height="35" Width="80" Margin="0,0,0,0"
            Background="#607D8B" Foreground="White" FontWeight="Bold"/>
            </StackPanel>

            <!-- 实时统计信息 -->
            <Border Background="#F0F0F0" Padding="10" Margin="0,15,0,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="📊 实时统计" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtTotal" Text="总数：0"/>
                    <TextBlock x:Name="TxtOK" Text="良品：0" Foreground="Green"/>
                    <TextBlock x:Name="TxtNG" Text="不良品：0" Foreground="Red"/>
                    <TextBlock x:Name="TxtRate" Text="良率：0%"/>
                </StackPanel>
            </Border>

            <!-- 状态信息 -->
            <TextBlock x:Name="TxtStatus" Text="⚪ 未连接" Margin="0,15,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
